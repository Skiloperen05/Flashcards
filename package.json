{
  "name": "haugnes-flashcards",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "npm run check:js && npm run check:smoke",
    "check": "npm run check:js && npm run check:smoke && npm run check:learning && npm run check:biome",
    "check:js": "node scripts/check-js.mjs",
    "check:smoke": "node scripts/smoke-test.mjs",
    "learning:generate": "node scripts/generate-learning-content.mjs",
    "check:learning": "node scripts/generate-learning-content.mjs --check",
    "check:biome": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
