{
  "name": "haugnes-flashcards",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "npm run check:js && npm run check:smoke && npm run check:study && npm run check:content",
    "check": "npm run check:js && npm run check:smoke && npm run check:learning && npm run check:semester && npm run check:study && npm run check:content && npm run check:biome",
    "check:js": "node scripts/check-js.mjs",
    "check:smoke": "node scripts/smoke-test.mjs",
    "check:study": "node scripts/generate-sam3-flashcards.mjs --check && node scripts/generate-coso-study.mjs --check && node scripts/flashcard-study-test.mjs",
    "check:documents": "node scripts/document-access-test.mjs && node scripts/subject-publishing-test.mjs",
    "learning:generate": "node scripts/generate-learning-content.mjs",
    "check:learning": "node scripts/generate-learning-content.mjs --check",
    "check:biome": "biome check .",
    "format": "biome format --write .",
    "sam3:generate": "node scripts/generate-sam3-flashcards.mjs",
    "semester:generate": "node scripts/generate-first-semester.mjs",
    "check:semester": "node scripts/generate-first-semester.mjs --check",
    "coso:generate": "node scripts/generate-coso-study.mjs",
    "check:content": "node scripts/content-cleanup-test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "jsdom": "^30.0.1"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
